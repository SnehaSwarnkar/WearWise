# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.env
.venv/
venv/
backend/venv/
backend/fastapi_env/

# ── Backend runtime data (generated at run time, not source) ──────────────────
backend/data/
backend/uploads/

