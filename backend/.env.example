# ═══════════════════════════════════════════════════════
# WearWise Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env to Git.
# ═══════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS origins (comma-separated) ──────────────────────
# Add your production frontend URL here when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Data directory ───────────────────────────────────────
# Path where JSON collection files are stored.
# Default: backend/data/ (relative to main.py)
# DATA_DIR=./data

# ── Upload directory ─────────────────────────────────────
# Path where user-uploaded files are stored.
# Default: backend/uploads/ (relative to main.py)
# UPLOADS_DIR=./uploads

# ── Auth secret ──────────────────────────────────────────
# Used to generate deterministic tokens.
# Change this to a long random string in production.
# In production, replace the token system with JWT (python-jose).
SECRET_KEY=change-me-to-a-long-random-secret-in-production

# ── Max file upload size (bytes) ────────────────────────
MAX_UPLOAD_BYTES=10485760   # 10 MB
