# WearWise Shared Environment Configuration
# Copy this file to .env and fill in your MongoDB Atlas connection URI

# MongoDB Atlas Connection URI (required)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Logical Databases
MONGODB_COMMERCE_DB=wearwise_commerce
MONGODB_BODY_ENGINE_DB=wearwise_body_engine

# Driver connection timeout in milliseconds
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Application environment (development | production | test)
APP_ENV=development

# External Image Virtual Try-On Provider (optional — omit to keep Photo Try-On honestly unavailable)
# Supported: FASHN AI API v1 (`VTON_PROVIDER=fashn` + `FASHN_API_KEY`) or custom HTTP (`VTON_API_URL` + `VTON_API_KEY`)
VTON_PROVIDER=fashn
FASHN_API_KEY=
VTON_API_URL=
VTON_API_KEY=
VTON_PROVIDER_MODE=auto
