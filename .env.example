# ==============================================================================
# WearWise — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment mode.
# DO NOT commit production secrets, keys, or credential tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# Controls application runtime mode: 'development', 'test', or 'production'.
# In 'production', all development headers (X-User-Id, X-Brand-Id) and fallbacks
# are strictly rejected, CORS is restricted to explicit origins, and cryptographic
# Bearer token verification is enforced.
WEARWISE_ENV=development

# ------------------------------------------------------------------------------
# 2. DEVELOPMENT AUTHENTICATION ADAPTER
# ------------------------------------------------------------------------------
# Set to 'true' to enable local multi-principal switching via headers/localStorage.
# Automatically disabled and ignored when WEARWISE_ENV=production.
ALLOW_DEV_AUTH=true

# ------------------------------------------------------------------------------
# 3. JWT TOKEN VERIFICATION CONTRACT
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying HMAC-SHA256 JWT access tokens.
# IMPORTANT: In production, generate a cryptographically strong 32+ byte secret.
JWT_SECRET_KEY=wearwise-dev-signing-key-for-local-testing-only-32bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=wearwise:auth
JWT_AUDIENCE=wearwise:api
JWT_EXPIRY_MINUTES=60

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Default is local SQLite in WAL mode.
# For production PostgreSQL deployments, provide a standard SQLAlchemy connection URI.
DATABASE_URL=sqlite:///data/wearwise.db
# Example PostgreSQL:
# DATABASE_URL=postgresql+psycopg://wearwise_user:secure_password@localhost:5432/wearwise_prod

# ------------------------------------------------------------------------------
# 5. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. In development, defaults to standard
# Vite and React development ports (3000, 5173). In production, this MUST be set.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. FRONTEND API CONFIGURATION (Vite Client)
# ------------------------------------------------------------------------------
# Configures the target backend API endpoint for the React frontend client.
# Placed in frontend/.env for Vite bundle injection.
VITE_API_URL=http://localhost:8000
